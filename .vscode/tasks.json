{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build, Run & Tests",
            "type": "shell",
            "command": "pytest",
            "args": [
                "-q",
                "--tb=short",
                "--disable-warnings"
            ],
            "options": {
                "cwd": "${workspaceFolder}/test"
            },
            "group": "build",
            "problemMatcher": []
        }
    ]
}